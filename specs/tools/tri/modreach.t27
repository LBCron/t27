// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/modreach.t27 -- tool tri/mods, the `tri mods` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/mods).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_mods;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/mods";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/mods";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri mods";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Mods";
pub const SOURCE : str = "cli/tri/src/modreach.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "Source files no crate root reaches, and so nothing compiles. Test-harness hygiene.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Mods (cli/tri/src/main.rs; module cli/tri/src/modreach.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [1]str = ["orphan"];
pub const ACTIONS_ABOUT : [1]str = ["List them."];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [2]str = ["gate: Compare against docs/reports/orphan_modules.json...", "self_check: Negative control: prove this gate can see a planted orphan."];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "C"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead C: ABOUT \"Source files no crate root reaches\" -- domain lead for module inventory.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Source files no crate root reaches, and so nothing compiles. Test-harness hygiene.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_constants {
    assert KIND == "tool";
    assert FAMILY == "tri-cli";
    assert ID == "tri/mods";
    assert REPO == "gHashTag/t27";
    assert QUALIFIED_ID == "gHashTag/t27:tri/mods";
    assert SCHEMA == 2;
    assert COMMAND == "tri mods";
    assert VARIANT == "Commands::Mods";
    assert ENABLED == true;
    assert AGENTS[0] == "T";
    assert AGENTS[1] == "C";
    assert ACTIONS[0] == "orphan";
}
