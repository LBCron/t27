// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/skillnum.t27 -- tool tri/skill, the `tri skill` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/skill).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_skill;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/skill";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/skill";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri skill";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Skill";
pub const SOURCE : str = "cli/tri/src/skillnum.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "Write a new lesson to the spool, unnumbered.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Skill (cli/tri/src/main.rs; module cli/tri/src/skillnum.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [6]str = ["add", "fold", "check", "lost", "refs", "claims"];
pub const ACTIONS_ABOUT : [6]str = ["Write a new lesson to the spool, unnumbered.", "Fold every spooled lesson into SKILL.md, numbering them on the way in.", "Check every SKILL.md's section numbering.", "Sections whose body was truncated at some point in the file's history.", "Every cross-reference in the skills, and whether it resolves.", "Sections that state a FIGURE, and which of those a reader can re-take."];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [0]str = [];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "C"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead C: ABOUT \"Write a new lesson to the spool, unnumbered\" and six actions managing skill spool files, folding, checking, lost truncation, refs, and claims -- skills/crons.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "Write a new lesson to the spool, unnumbered.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_constants {
    assert KIND == "tool";
    assert FAMILY == "tri-cli";
    assert ID == "tri/skill";
    assert REPO == "gHashTag/t27";
    assert QUALIFIED_ID == "gHashTag/t27:tri/skill";
    assert SCHEMA == 2;
    assert COMMAND == "tri skill";
    assert VARIANT == "Commands::Skill";
    assert ENABLED == true;
    assert AGENTS[0] == "T";
    assert AGENTS[1] == "C";
    assert ACTIONS[0] == "add";
    assert ACTIONS[1] == "fold";
    assert ACTIONS[2] == "check";
    assert ACTIONS[3] == "lost";
    assert ACTIONS[4] == "refs";
    assert ACTIONS[5] == "claims";
}
