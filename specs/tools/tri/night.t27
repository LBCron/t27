// SPDX-License-Identifier: Apache-2.0
; specs/tools/tri/night.t27 -- tool tri/night, the `tri night` command of the tri CLI
; Source of truth for the tool card on t27.ai (#/tools?tool=tri/night).
; Extracted from the clap #[derive(Subcommand)] enums in cli/tri/src (witness source-parse:
; cargo was not run, the enum and its /// docs were read at commit 3cb7a4352492).
; Layer 5 of the ladder Specs -> Skills -> Crons -> Agents -> Tools. ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module tool_tri_night;

pub const KIND : str = "tool";
pub const FAMILY : str = "tri-cli";
pub const ID : str = "tri/night";
pub const REPO : str = "gHashTag/t27";
pub const QUALIFIED_ID : str = "gHashTag/t27:tri/night";
pub const SCHEMA : u32 = 2;
pub const COMMAND : str = "tri night";
; clap enum variant and where the dispatch lands
pub const VARIANT : str = "Commands::Night";
pub const SOURCE : str = "cli/tri/src/night.rs";
pub const ENTRY : str = "cli/tri/src/main.rs";
; The clap about text (first /// paragraph), as `tri --help` would print it.
pub const ABOUT : str = "The whole overnight operation in one command: train order, per-PR verdicts, failed runs, and the single next action.";
pub const ABOUT_SOURCE : str = "clap /// doc on Commands::Night (cli/tri/src/main.rs; module cli/tri/src/night.rs)";
; Nested subcommands (kebab-case as clap derives them) and their first /// paragraph ("" when none).
pub const ACTIONS : [0]str = [];
pub const ACTIONS_ABOUT : [0]str = [];
; Top-level arguments/flags of the command itself, "<name>: doc".
pub const ARGS : [2]str = ["repo: Repository to read (default gHashTag/t27).", "limit: How many failed runs to print."];
; Agent letters that own this command, only where a source line names it (AGENTS_NOTE cites it).
pub const AGENTS : [2]str = ["T", "B"];
pub const AGENTS_NOTE : str = "docs/agents/AGENTS_ALPHABET.md \"Who holds a tool, and who holds a skill\" binds every tool to the Queen (T). Domain lead B: ABOUT \"The whole overnight operation in one command\" -- night loop.";
; From the about text (long about when the doc has more than one paragraph); no marketing.
pub const WHEN_TO_USE : str = "The whole overnight operation in one command: train order, per-PR verdicts, failed runs, and the single next action.";
pub const WITNESS : str = "source-parse";
pub const ENABLED : bool = true;

test verify_constants {
    assert KIND == "tool";
    assert FAMILY == "tri-cli";
    assert ID == "tri/night";
    assert REPO == "gHashTag/t27";
    assert QUALIFIED_ID == "gHashTag/t27:tri/night";
    assert SCHEMA == 2;
    assert COMMAND == "tri night";
    assert VARIANT == "Commands::Night";
    assert ENABLED == true;
    assert AGENTS[0] == "T";
    assert AGENTS[1] == "B";
    assert ARGS[0] == "repo: Repository to read (default gHashTag/t27).";
    assert ARGS[1] == "limit: How many failed runs to print.";
}
