; specs/t27os/agents/syntax_sampler.t27 -- letter L's first instrument: syntax-vNEXT sampler
; Letter L (Language / Syntax vNEXT) has no widget, no surface and no pin.
; This card samples syntax rules from the vNEXT module line: rule names, arity, and whether each is implemented.
; Closes the G_NO_INSTRUMENT gap for letter L.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module syntax_sampler_card;

pub const KIND : str = "widget-card";
pub const ID : str = "syntax-sampler";
pub const TITLE : str = "Syntax sampler: vNEXT module line for letter L";
pub const DESCRIPTION : str = "Samples syntax rules from the vNEXT module line: rule names, arity, and implementation status. Letter L's first instrument.";
pub const HOOK : str = "Letter L samples the syntax rules one rule at a time.";
pub const CATEGORY : str = "language";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The vNEXT syntax rules -------------------------------------------------------
pub const K_RULE_COUNT : u8 = 9;
pub const K_RULE_NAMES : [9]str = ["module-decl", "import", "pub-const", "pub-fn", "struct", "enum", "test", "invariant", "endmodule"];
pub const K_RULE_ARITY : [9]u8 = [1, 1, 1, 1, 1, 1, 0, 0, 0];
pub const K_RULE_IMPLEMENTED : [9]bool = [true, true, true, true, true, true, true, true, true];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Syntax Rule Sampler";
pub const SAY_NONE : str = "No syntax rules sampled.";
pub const SAY_RULE : str = "rule";
pub const SAY_ARITY : str = "arity";
pub const SAY_IMPLEMENTED : str = "implemented";
pub const SAY_DIRECTORY : str = "specs/t27f/glyph57.t27 holds the vNEXT syntax rules; each line is one rule.";

; --- Counts ----------------------------------------------------------------------
pub fn rule_count() -> u32 {
    return K_RULE_COUNT as u32;
}

pub fn rule_name(i: u32) -> string {
    if (i < K_RULE_COUNT as u32) { return K_RULE_NAMES[i as usize]; }
    return "";
}

pub fn rule_arity(i: u32) -> u32 {
    if (i < K_RULE_COUNT as u32) { return K_RULE_ARITY[i as usize] as u32; }
    return 0;
}

pub fn rule_implemented(i: u32) -> bool {
    if (i < K_RULE_COUNT as u32) { return K_RULE_IMPLEMENTED[i as usize]; }
    return false;
}

; --- Derived ---------------------------------------------------------------------
pub fn implemented_count() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_RULE_COUNT as u32) {
        if (rule_implemented(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn unimplemented_count() -> u32 {
    return rule_count() - implemented_count();
}

test syntax_sampler_has_nine_rules {
    assert rule_count() == 9;
    assert rule_name(0) == "module-decl";
    assert rule_name(1) == "import";
    assert rule_name(8) == "endmodule";
}

test syntax_sampler_all_implemented {
    var i : u32 = 0;
    while (i < 9) {
        assert rule_implemented(i) == true;
        i = i + 1;
    }
}

test out_of_range_returns_empty {
    assert rule_name(9) == "";
    assert rule_arity(9) == 0;
    assert rule_implemented(9) == false;
}

test implemented_count_is_nine {
    assert implemented_count() == 9;
}

test unimplemented_count_is_zero {
    assert unimplemented_count() == 0;
}

test header_is_fixed {
    assert SAY_HEADER == "Syntax Rule Sampler";
    assert SAY_DIRECTORY == "specs/t27f/glyph57.t27 holds the vNEXT syntax rules; each line is one rule.";
}

invariant arities_are_nonnegative {
    var i : u32 = 0;
    while (i < 9) {
        assert rule_arity(i) >= 0;
        i = i + 1;
    }
}

endmodule
