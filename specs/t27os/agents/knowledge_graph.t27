// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/knowledge_graph.t27 -- letter G's first instrument: knowledge graph card
; Letter G (Graph / ArchBench) has no widget, no surface and no pin.
; This card reads the spec dependency graph: nodes, edges, and owning letters.
; Closes the G_NO_INSTRUMENT gap for letter G.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module knowledge_graph_card;

pub const KIND : str = "widget-card";
pub const ID : str = "knowledge-graph";
pub const TITLE : str = "Knowledge graph: spec dependency edges for letter G";
pub const DESCRIPTION : str = "Readout of the spec dependency graph: node names, edge counts, and owning letters, one per line. Letter G's first instrument.";
pub const HOOK : str = "Letter G graphs the spec dependencies one edge at a time.";
pub const CATEGORY : str = "graph";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The knowledge graph nodes -------------------------------------------------------
pub const K_NODE_COUNT : u8 = 12;
pub const K_NODE_NAMES : [12]str = ["specs/core", "specs/fpga", "specs/numeric", "specs/tri", "specs/t27os", "specs/claw", "specs/igla", "specs/trios", "specs/verified", "specs/golden", "specs/physics", "specs/queen"];
pub const K_NODE_OWNER : [12]u8 = [3, 11, 14, 3, 19, 3, 3, 19, 19, 14, 14, 20];
pub const K_EDGE_COUNT : u8 = 17;

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Knowledge Graph";
pub const SAY_NONE : str = "No nodes in the graph.";
pub const SAY_NODE : str = "node";
pub const SAY_OWNER : str = "owner";
pub const SAY_EDGE_COUNT : str = "edges";
pub const SAY_DIRECTORY : str = "specs/ holds the dependency graph; each spec is one node.";

; --- Counts ----------------------------------------------------------------------
pub fn node_count() -> u32 {
    return K_NODE_COUNT as u32;
}

pub fn node_name(i: u32) -> string {
    if (i < K_NODE_COUNT as u32) { return K_NODE_NAMES[i as usize]; }
    return "";
}

pub fn node_owner(i: u32) -> u32 {
    if (i < K_NODE_COUNT as u32) { return K_NODE_OWNER[i as usize]; }
    return 0;
}

pub fn edge_count() -> u32 {
    return K_EDGE_COUNT as u32;
}

; --- Derived ---------------------------------------------------------------------
pub fn owned_by_c() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_NODE_COUNT as u32) {
        if (node_owner(i) == 3) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn owned_by_s() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_NODE_COUNT as u32) {
        if (node_owner(i) == 19) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test knowledge_graph_has_twelve_nodes {
    assert node_count() == 12;
    assert node_name(0) == "specs/core";
    assert node_name(1) == "specs/fpga";
    assert node_name(11) == "specs/queen";
}

test knowledge_graph_node_owners {
    assert node_owner(0) == 3;
    assert node_owner(1) == 11;
    assert node_owner(11) == 20;
}

test edge_count_is_seventeen {
    assert edge_count() == 17;
}

test owned_by_c_is_four {
    assert owned_by_c() == 4;
}

test owned_by_s_is_four {
    assert owned_by_s() == 3;
}

test header_is_fixed {
    assert SAY_HEADER == "Knowledge Graph";
    assert SAY_DIRECTORY == "specs/ holds the dependency graph; each spec is one node.";
}

invariant node_owners_are_valid {
    var i : u32 = 0;
    while (i < K_NODE_COUNT as u32) {
        assert node_owner(i) >= 1;
        assert node_owner(i) <= 27;
        i = i + 1;
    }
}

endmodule
