; specs/t27os/agents/numeric_goldenfloat.t27 -- letter N's first instrument: numeric format card
; Letter N (Numeric / GoldenFloat) has no widget, no surface and no pin.
; This card reads the numeric format family: format names, bit widths, and biases.
; Closes the G_NO_INSTRUMENT gap for letter N.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module numeric_goldenfloat_card;

pub const KIND : str = "widget-card";
pub const ID : str = "numeric-goldenfloat";
pub const TITLE : str = "Numeric formats: GoldenFloat family for letter N";
pub const DESCRIPTION : str = "Readout of the GoldenFloat family: format names, bit widths, and biases, one per line. Letter N's first instrument.";
pub const HOOK : str = "Letter N measures the numeric formats one width at a time.";
pub const CATEGORY : str = "numeric";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The numeric format family -------------------------------------------------------
pub const K_FORMAT_COUNT : u8 = 7;
pub const K_FORMAT_NAMES : [7]str = ["GF4", "GF8", "GF16", "GF32", "GF64", "GF128", "GF256"];
pub const K_FORMAT_BITS : [7]u32 = [4, 8, 16, 32, 64, 128, 256];
pub const K_FORMAT_BIAS : [7]u32 = [3, 7, 31, 127, 1023, 16383, 65535];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Numeric Format Family";
pub const SAY_NONE : str = "No formats in the family.";
pub const SAY_FORMAT : str = "format";
pub const SAY_BITS : str = "bits";
pub const SAY_BIAS : str = "bias";
pub const SAY_DIRECTORY : str = "conformance/FORMAT-SPEC-001.json holds the format registry.";

; --- Counts ----------------------------------------------------------------------
pub fn format_count() -> u32 {
    return K_FORMAT_COUNT as u32;
}

pub fn format_name(i: u32) -> string {
    if (i < K_FORMAT_COUNT as u32) { return K_FORMAT_NAMES[i as usize]; }
    return "";
}

pub fn format_bits(i: u32) -> u32 {
    if (i < K_FORMAT_COUNT as u32) { return K_FORMAT_BITS[i as usize]; }
    return 0;
}

pub fn format_bias(i: u32) -> u32 {
    if (i < K_FORMAT_COUNT as u32) { return K_FORMAT_BIAS[i as usize]; }
    return 0;
}

; --- Derived ---------------------------------------------------------------------
pub fn total_bits() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_FORMAT_COUNT as u32) {
        n = n + format_bits(i);
        i = i + 1;
    }
    return n;
}

pub fn has_bias(i: u32) -> bool {
    if (i < K_FORMAT_COUNT as u32) { return K_FORMAT_BIAS[i as usize] > 0; }
    return false;
}

test numeric_goldenfloat_has_seven_formats {
    assert format_count() == 7;
    assert format_name(0) == "GF4";
    assert format_name(1) == "GF8";
    assert format_name(6) == "GF256";
}

test numeric_goldenfloat_bits {
    assert format_bits(0) == 4;
    assert format_bits(1) == 8;
    assert format_bits(6) == 256;
}

test out_of_range_returns_empty {
    assert format_name(7) == "";
    assert format_bits(7) == 0;
    assert format_bias(7) == 0;
}

test total_bits_is_sum {
    assert total_bits() == 508;
}

test has_bias_for_all {
    var i : u32 = 0;
    while (i < K_FORMAT_COUNT as u32) {
        assert has_bias(i) == true;
        i = i + 1;
    }
}

test header_is_fixed {
    assert SAY_HEADER == "Numeric Format Family";
    assert SAY_DIRECTORY == "conformance/FORMAT-SPEC-001.json holds the format registry.";
}

invariant bits_are_positive {
    var i : u32 = 0;
    while (i < K_FORMAT_COUNT as u32) {
        assert format_bits(i) > 0;
        i = i + 1;
    }
}

endmodule
