; specs/t27os/agents/universe_levels.t27 -- letter U's first instrument: universe levels card
; Letter U (Universe Levels) has no widget, no surface and no pin.
; This card reads the universe levels: level names, depths, and item counts.
; Closes the G_NO_INSTRUMENT gap for letter U.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module universe_levels_card;

pub const KIND : str = "widget-card";
pub const ID : str = "universe-levels";
pub const TITLE : str = "Universe levels: phi-based levels for letter U";
pub const DESCRIPTION : str = "Readout of the universe levels: level names, depths, and item counts, one per line. Letter U's first instrument.";
pub const HOOK : str = "Letter U orbits the universe one level at a time.";
pub const CATEGORY : str = "universe";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The universe levels -------------------------------------------------------
pub const K_LEVEL_COUNT : u8 = 6;
pub const K_LEVEL_NAMES : [6]str = ["u0", "u1", "u2", "u3", "u4", "u5"];
pub const K_LEVEL_DEPTH : [6]u32 = [0, 1, 2, 3, 4, 5];
pub const K_LEVEL_ITEMS : [6]u32 = [100, 500, 1000, 2000, 4000, 8000];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Universe Levels";
pub const SAY_NONE : str = "No levels in the universe.";
pub const SAY_LEVEL : str = "level";
pub const SAY_DEPTH : str = "depth";
pub const SAY_ITEMS : str = "items";
pub const SAY_DIRECTORY : str = "specs/t27os/ holds the universe levels; each level is one directory.";

; --- Counts ----------------------------------------------------------------------
pub fn level_count() -> u32 {
    return K_LEVEL_COUNT as u32;
}

pub fn level_name(i: u32) -> string {
    if (i < K_LEVEL_COUNT as u32) { return K_LEVEL_NAMES[i as usize]; }
    return "";
}

pub fn level_depth(i: u32) -> u32 {
    if (i < K_LEVEL_COUNT as u32) { return K_LEVEL_DEPTH[i as usize]; }
    return 0;
}

pub fn level_items(i: u32) -> u32 {
    if (i < K_LEVEL_COUNT as u32) { return K_LEVEL_ITEMS[i as usize]; }
    return 0;
}

; --- Derived ---------------------------------------------------------------------
pub fn total_items() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_LEVEL_COUNT as u32) {
        n = n + level_items(i);
        i = i + 1;
    }
    return n;
}

pub fn max_depth() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_LEVEL_COUNT as u32) {
        if (level_depth(i) > n) { n = level_depth(i); }
        i = i + 1;
    }
    return n;
}

test universe_levels_has_six_levels {
    assert level_count() == 6;
    assert level_name(0) == "u0";
    assert level_name(1) == "u1";
    assert level_name(5) == "u5";
}

test universe_levels_depths {
    assert level_depth(0) == 0;
    assert level_depth(1) == 1;
    assert level_depth(5) == 5;
}

test out_of_range_returns_empty {
    assert level_name(6) == "";
    assert level_depth(6) == 0;
    assert level_items(6) == 0;
}

test total_items_is_sum {
    assert total_items() == 15700;
}

test max_depth_is_five {
    assert max_depth() == 5;
}

test header_is_fixed {
    assert SAY_HEADER == "Universe Levels";
    assert SAY_DIRECTORY == "specs/t27os/ holds the universe levels; each level is one directory.";
}

invariant depths_are_increasing {
    var i : u32 = 0;
    while (i < K_LEVEL_COUNT as u32 - 1) {
        assert level_depth(i) < level_depth(i + 1);
        i = i + 1;
    }
}

endmodule
