// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/external_bindings.t27 -- widget card for letter X (External Bindings / Interop).
; Letter X's first instrument: a readout of the cross-language bindings the widget exposes,
; their names, and whether each is bound. All numbers are computed by the spec itself.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module ExternalBindingsCard;

pub const KIND : str = "widget-card";
pub const ID : str = "external-bindings";
pub const TITLE : str = "External bindings: cross-language bindings for letter X";
pub const DESCRIPTION : str = "Letter X's first instrument: the cross-language binding table, binding by binding.";

pub const BINDING_COUNT : u32 = 5;

pub const BINDING_NAMES : [5]str = [
    "C bridge", "T bridge", "N bridge", "Z bridge", "V bridge",
];

pub const BINDING_OWNER : [5]u8 = [
    3, 20, 14, 26, 22,
];

/// How many external bindings the widget card shows.
pub fn binding_count() -> u32 {
    return BINDING_COUNT;
}

/// The name of binding i, or "" past the end.
pub fn binding_name(i: u32) -> str {
    if (i >= BINDING_COUNT) { return ""; }
    return BINDING_NAMES[i];
}

/// The owning letter of binding i (C=3, T=20, N=14, Z=26, V=22).
pub fn binding_owner(i: u32) -> u8 {
    if (i >= BINDING_COUNT) { return 0; }
    return BINDING_OWNER[i];
}

/// Is binding i bound (owner in range 1..27)?
pub fn binding_is_bound(i: u32) -> bool {
    const o : u8 = binding_owner(i);
    return o >= 1 and o <= 27;
}

test widget_card_has_kind_and_id {
    assert KIND == "widget-card";
    assert ID == "external-bindings";
}

test widget_card_title_and_description_are_set {
    assert TITLE.len > 0;
    assert DESCRIPTION.len > 0;
    assert TITLE == "External bindings: cross-language bindings for letter X";
}

test binding_count_is_5 {
    assert binding_count() == 5;
    assert BINDING_COUNT == 5;
}

test binding_names_cover_all_five {
    assert binding_name(0) == "C bridge";
    assert binding_name(1) == "T bridge";
    assert binding_name(2) == "N bridge";
    assert binding_name(3) == "Z bridge";
    assert binding_name(4) == "V bridge";
    assert binding_name(5) == "";
}

test binding_owners_match_feeders {
    assert binding_owner(0) == 3;
    assert binding_owner(1) == 20;
    assert binding_owner(2) == 14;
    assert binding_owner(3) == 26;
    assert binding_owner(4) == 22;
}

test all_five_bindings_are_bound {
    assert binding_is_bound(0);
    assert binding_is_bound(1);
    assert binding_is_bound(2);
    assert binding_is_bound(3);
    assert binding_is_bound(4);
    assert !binding_is_bound(5);
}

invariant binding_count_constant {
    assert BINDING_COUNT == 5;
}

invariant binding_names_exist {
    assert binding_name(0) == "C bridge";
    assert binding_name(4) == "V bridge";
}

endmodule
