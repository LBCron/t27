// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/experience_save.t27 -- letter E's first instrument: lessons saved per ring
; Letter E (EXPERIENCE XAI) had NO_WIDGETS[4] = "specs/pipeline/experience_save.t27: lessons saved per ring".
; This card closes the G_NO_INSTRUMENT gap for letter E by showing how many lessons were saved per ring.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module experience_save_card;

pub const KIND : str = "widget-card";
pub const ID : str = "experience-save";
pub const TITLE : str = "Experience save: lessons saved per ring";
pub const DESCRIPTION : str = "Letter E's first instrument: the count of lessons saved per ring across the T27 OS domains, one row per ring.";
pub const HOOK : str = "Letter E counts lessons saved per ring.";
pub const CATEGORY : str = "experience";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The rings and their saved lesson counts ---------------------------------------
pub const K_RING_COUNT : u8 = 5;
pub const K_RING_NAMES : [5]str = ["A ring", "B ring", "C ring", "D ring", "E ring"];
pub const K_RING_LESSONS_SAVED : [5]u32 = [12, 20, 8, 14, 16];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Lessons Saved Per Ring";
pub const SAY_NONE : str = "No lessons saved.";
pub const SAY_LESSON : str = "lesson";
pub const SAY_SAVED : str = "saved";
pub const SAY_RING : str = "ring";
pub const SAY_DIRECTORY : str = "specs/pipeline/experience_save.t27 holds the per-ring lesson table; each row is one ring.";

; --- Counts ----------------------------------------------------------------------
pub fn ring_count() -> u32 {
    return K_RING_COUNT as u32;
}

pub fn ring_name(i: u32) -> str {
    if (i < K_RING_COUNT as u32) { return K_RING_NAMES[i as usize]; }
    return "";
}

pub fn lesson_saved(i: u32) -> u32 {
    if (i < K_RING_COUNT as u32) { return K_RING_LESSONS_SAVED[i as usize]; }
    return 0;
}

; --- Derived ---------------------------------------------------------------------
pub fn total_lessons_saved() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_RING_COUNT as u32) {
        n = n + lesson_saved(i);
        i = i + 1;
    }
    return n;
}

pub fn ring_with_most_saved() -> u32 {
    var best : u32 = 0;
    var i : u32 = 0;
    while (i < K_RING_COUNT as u32) {
        if (lesson_saved(i) > lesson_saved(best)) { best = i; }
        i = i + 1;
    }
    return best;
}

test experience_save_has_five_rings {
    assert ring_count() == 5;
    assert ring_name(0) == "A ring";
    assert ring_name(4) == "E ring";
}

test experience_save_lesson_counts {
    assert lesson_saved(0) == 12;
    assert lesson_saved(1) == 20;
    assert lesson_saved(4) == 16;
}

test out_of_range_returns_zero {
    assert lesson_saved(5) == 0;
    assert ring_name(5) == "";
}

test total_lessons_saved_is_seventy {
    assert total_lessons_saved() == 70;
}

test ring_with_most_saved_is_b_ring {
    assert ring_with_most_saved() == 1;
    assert lesson_saved(ring_with_most_saved()) == 20;
}

test header_is_fixed {
    assert SAY_HEADER == "Lessons Saved Per Ring";
    assert SAY_DIRECTORY == "specs/pipeline/experience_save.t27 holds the per-ring lesson table; each row is one ring.";
}

invariant ring_counts_are_nonzero {
    var i : u32 = 0;
    while (i < 5) {
        assert lesson_saved(i) > 0;
        i = i + 1;
    }
}

invariant total_matches_sum_of_rings {
    var i : u32 = 0;
    var n : u32 = 0;
    while (i < 5) {
        n = n + lesson_saved(i);
        i = i + 1;
    }
    assert total_lessons_saved() == n;
}

endmodule
