// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/sacred_physics.t27 -- letter P's first instrument: sacred physics card
; Letter P (Sacred Physics) has no widget. This card shows five phi-based physics formulas
; from the Trinity formula registry: gamma_phi, ln2_over_pi, ln3_over_pi, alpha_s and koide_q.
; Closes the G_NO_INSTRUMENT gap for letter P.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module sacred_physics_card;

pub const KIND : str = "widget-card";
pub const ID : str = "sacred-physics";
pub const TITLE : str = "Sacred physics: phi-based constants for letter P";
pub const DESCRIPTION : str = "Letter P's first instrument: five verified phi-based physics formulas from the Trinity formula registry, each with its sector and measured deviation.";
pub const HOOK : str = "Letter P shows phi-based constants, one formula at a time.";
pub const CATEGORY : str = "physics";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- Five phi-based physics formulas (from specs/physics/formula_registry.t27) -----------
pub const K_FORMULA_COUNT : u8 = 5;

pub const K_FORMULA_NAMES : [5]str = [
    "gamma_phi", "ln2_over_pi", "ln3_over_pi", "alpha_s", "koide_q"
];

pub const K_FORMULA_SECTORS : [5]str = [
    "gauge-coupling", "gauge-coupling", "gauge-coupling", "gauge-coupling", "lepton"
];

pub const K_FORMULA_DELTA_BP : [5]u16 = [
    62, 0, 0, 29, 0
];

pub const K_FORMULA_VALUES : [5]f64 = [
    0.2272402431736434, 0.22063560015296082, 0.3501678259626753, 0.13797024170913935, 0.6666666666666666
];

; --- Words on the card -----------------------------------------------------------------
pub const SAY_HEADER : str = "Sacred Physics";
pub const SAY_NONE : str = "No formulas in the registry.";
pub const SAY_FORMULA : str = "formula";
pub const SAY_SECTOR : str = "sector";
pub const SAY_DELTA : str = "delta basis points";
pub const SAY_DIRECTORY : str = "specs/physics/formula_registry.t27 holds the 69 phi-parametrizations; this card shows five of them for letter P.";

; --- Counts ----------------------------------------------------------------------------
pub fn formula_count() -> u32 {
    return K_FORMULA_COUNT as u32;
}

pub fn formula_name(i: u32) -> string {
    if (i < K_FORMULA_COUNT as u32) { return K_FORMULA_NAMES[i as usize]; }
    return "";
}

pub fn formula_sector(i: u32) -> string {
    if (i < K_FORMULA_COUNT as u32) { return K_FORMULA_SECTORS[i as usize]; }
    return "";
}

pub fn formula_delta_bp(i: u32) -> u32 {
    if (i < K_FORMULA_COUNT as u32) { return K_FORMULA_DELTA_BP[i as usize] as u32; }
    return 0;
}

pub fn formula_value(i: u32) -> f64 {
    if (i < K_FORMULA_COUNT as u32) { return K_FORMULA_VALUES[i as usize]; }
    return 0.0;
}

; --- Derived ---------------------------------------------------------------------------
pub fn verified_count() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_FORMULA_COUNT as u32) {
        if (formula_delta_bp(i) < 1000) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test sacred_physics_has_five_formulas {
    assert formula_count() == 5;
    assert formula_name(0) == "gamma_phi";
    assert formula_name(1) == "ln2_over_pi";
    assert formula_name(2) == "ln3_over_pi";
    assert formula_name(3) == "alpha_s";
    assert formula_name(4) == "koide_q";
}

test sacred_physics_out_of_range_returns_empty {
    assert formula_name(5) == "";
    assert formula_sector(5) == "";
    assert formula_delta_bp(5) == 0;
    assert formula_value(5) == 0.0;
}

test sacred_physics_all_verified {
    assert verified_count() == 5;
    assert formula_delta_bp(0) == 62;
    assert formula_delta_bp(1) == 0;
    assert formula_delta_bp(2) == 0;
    assert formula_delta_bp(3) == 29;
    assert formula_delta_bp(4) == 0;
}

test header_is_fixed {
    assert SAY_HEADER == "Sacred Physics";
    assert SAY_DIRECTORY == "specs/physics/formula_registry.t27 holds the 69 phi-parametrizations; this card shows five of them for letter P.";
}

invariant all_formulas_have_names {
    var i : u32 = 0;
    while (i < K_FORMULA_COUNT as u32) {
        assert formula_name(i) != "";
        i = i + 1;
    }
}

invariant all_deltas_are_small {
    var i : u32 = 0;
    while (i < K_FORMULA_COUNT as u32) {
        assert formula_delta_bp(i) < 1000;
        i = i + 1;
    }
}

endmodule
