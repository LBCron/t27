// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/hslm_neural.t27 -- letter H's first instrument: HSLM neural card
; Letter H (HSLM / Neural Architectures) has no widget, no surface and no pin.
; This card reads the HSLM neural layer stack: layer names, neuron counts, and activation types.
; Closes the G_NO_INSTRUMENT gap for letter H.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module hslm_neural_card;

pub const KIND : str = "widget-card";
pub const ID : str = "hslm-neural";
pub const TITLE : str = "HSLM neural: ternary neural network layers for letter H";
pub const DESCRIPTION : str = "Readout of HSLM neural layers: layer names, neuron counts, and activation types, one per line. Letter H's first instrument.";
pub const HOOK : str = "Letter H computes the neural stack one layer at a time.";
pub const CATEGORY : str = "neural";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The HSLM neural layers -------------------------------------------------------
pub const K_LAYER_COUNT : u8 = 6;
pub const K_LAYER_NAMES : [6]str = ["input", "embed", "ternary_gemm", "phi_accum", "layer_norm", "output"];
pub const K_LAYER_NEURONS : [6]u32 = [784, 256, 128, 64, 32, 10];
pub const K_LAYER_ACTIVATION : [6]str = ["linear", "gelu", "ternary", "tanh", "layer_norm", "softmax"];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "HSLM Neural Layers";
pub const SAY_NONE : str = "No neural layers in the stack.";
pub const SAY_LAYER : str = "layer";
pub const SAY_NEURONS : str = "neurons";
pub const SAY_ACTIVATION : str = "activation";
pub const SAY_DIRECTORY : str = "specs/nn/ holds the neural layer specs; each layer is one spec.";

; --- Counts ----------------------------------------------------------------------
pub fn layer_count() -> u32 {
    return K_LAYER_COUNT as u32;
}

pub fn layer_name(i: u32) -> string {
    if (i < K_LAYER_COUNT as u32) { return K_LAYER_NAMES[i as usize]; }
    return "";
}

pub fn layer_neurons(i: u32) -> u32 {
    if (i < K_LAYER_COUNT as u32) { return K_LAYER_NEURONS[i as usize]; }
    return 0;
}

pub fn layer_activation(i: u32) -> string {
    if (i < K_LAYER_COUNT as u32) { return K_LAYER_ACTIVATION[i as usize]; }
    return "";
}

; --- Derived ---------------------------------------------------------------------
pub fn total_neurons() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_LAYER_COUNT as u32) {
        n = n + layer_neurons(i);
        i = i + 1;
    }
    return n;
}

pub fn ternary_layers() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_LAYER_COUNT as u32) {
        if (layer_activation(i) == "ternary") { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test hslm_neural_has_six_layers {
    assert layer_count() == 6;
    assert layer_name(0) == "input";
    assert layer_name(1) == "embed";
    assert layer_name(5) == "output";
}

test hslm_neural_neurons {
    assert layer_neurons(0) == 784;
    assert layer_neurons(1) == 256;
    assert layer_neurons(5) == 10;
}

test out_of_range_returns_empty {
    assert layer_name(6) == "";
    assert layer_neurons(6) == 0;
    assert layer_activation(6) == "";
}

test total_neurons_is_sum {
    assert total_neurons() == 1244;
}

test ternary_layers_is_one {
    assert ternary_layers() == 1;
}

test header_is_fixed {
    assert SAY_HEADER == "HSLM Neural Layers";
    assert SAY_DIRECTORY == "specs/nn/ holds the neural layer specs; each layer is one spec.";
}

invariant neuron_counts_are_positive {
    var i : u32 = 0;
    while (i < K_LAYER_COUNT as u32) {
        assert layer_neurons(i) > 0;
        i = i + 1;
    }
}

endmodule
