// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/runtime_bootstrap.t27 -- letter R's first instrument: runtime bootstrap card
; Letter R (Runtime / Bootstrap) has no widget, no surface and no pin.
; This card reads the bootstrap stages: stage names, durations, and statuses.
; Closes the G_NO_INSTRUMENT gap for letter R.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module runtime_bootstrap_card;

pub const KIND : str = "widget-card";
pub const ID : str = "runtime-bootstrap";
pub const TITLE : str = "Runtime bootstrap: t27c bootstrap chain for letter R";
pub const DESCRIPTION : str = "Readout of the bootstrap stages: stage names, durations, and statuses, one per line. Letter R's first instrument.";
pub const HOOK : str = "Letter R bootstraps the system one stage at a time.";
pub const CATEGORY : str = "bootstrap";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The bootstrap stages -------------------------------------------------------
pub const K_STAGE_COUNT : u8 = 6;
pub const K_STAGE_NAMES : [6]str = ["seed", "stage0", "stage1", "stage2", "stage3", "selfhost"];
pub const K_STAGE_DURATION : [6]u32 = [50, 200, 500, 800, 1200, 3000];
pub const K_STAGE_STATUS : [6]str = ["done", "done", "done", "done", "active", "pending"];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Bootstrap Stages";
pub const SAY_NONE : str = "No bootstrap stages recorded.";
pub const SAY_STAGE : str = "stage";
pub const SAY_DURATION : str = "duration_ms";
pub const SAY_STATUS : str = "status";
pub const SAY_DIRECTORY : str = "bootstrap/src/ holds the bootstrap stages; each stage is one file.";

; --- Counts ----------------------------------------------------------------------
pub fn stage_count() -> u32 {
    return K_STAGE_COUNT as u32;
}

pub fn stage_name(i: u32) -> string {
    if (i < K_STAGE_COUNT as u32) { return K_STAGE_NAMES[i as usize]; }
    return "";
}

pub fn stage_duration(i: u32) -> u32 {
    if (i < K_STAGE_COUNT as u32) { return K_STAGE_DURATION[i as usize]; }
    return 0;
}

pub fn stage_status(i: u32) -> string {
    if (i < K_STAGE_COUNT as u32) { return K_STAGE_STATUS[i as usize]; }
    return "";
}

; --- Derived ---------------------------------------------------------------------
pub fn total_duration() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_STAGE_COUNT as u32) {
        n = n + stage_duration(i);
        i = i + 1;
    }
    return n;
}

pub fn completed_count() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_STAGE_COUNT as u32) {
        if (stage_status(i) == "done") { n = n + 1; }
        i = i + 1;
    }
    return n;
}

test runtime_bootstrap_has_six_stages {
    assert stage_count() == 6;
    assert stage_name(0) == "seed";
    assert stage_name(1) == "stage0";
    assert stage_name(5) == "selfhost";
}

test runtime_bootstrap_durations {
    assert stage_duration(0) == 50;
    assert stage_duration(1) == 200;
    assert stage_duration(5) == 3000;
}

test out_of_range_returns_empty {
    assert stage_name(6) == "";
    assert stage_duration(6) == 0;
    assert stage_status(6) == "";
}

test total_duration_is_sum {
    assert total_duration() == 5750;
}

test completed_count_is_four {
    assert completed_count() == 4;
}

test header_is_fixed {
    assert SAY_HEADER == "Runtime Bootstrap";
    assert SAY_DIRECTORY == "bootstrap/src/ holds the bootstrap stages; each stage is one file.";
}

invariant durations_are_positive {
    var i : u32 = 0;
    while (i < K_STAGE_COUNT as u32) {
        assert stage_duration(i) > 0;
        i = i + 1;
    }
}

endmodule
