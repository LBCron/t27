// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/formal_conformance.t27 -- letter F's first instrument: formal conformance card
; Letter F (Formal Conformance) has no widget, no surface and no pin.
; This card reads conformance check vectors: names, thresholds, and pass/fail status.
; Closes the G_NO_INSTRUMENT gap for letter F.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module formal_conformance_card;

pub const KIND : str = "widget-card";
pub const ID : str = "formal-conformance";
pub const TITLE : str = "Formal conformance: format verification vectors for letter F";
pub const DESCRIPTION : str = "Readout of conformance check vectors: names, thresholds, and pass/fail status, one per line. Letter F's first instrument.";
pub const HOOK : str = "Letter F conforms to every check, one at a time.";
pub const CATEGORY : str = "conformance";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The conformance checks -------------------------------------------------------
pub const K_CHECK_COUNT : u8 = 5;
pub const K_CHECK_NAMES : [5]str = ["gf16", "tnf17", "posit8", "bf16", "mxfp4"];
pub const K_CHECK_THRESHOLD : [5]u32 = [1000, 500, 2000, 100, 5000];
pub const K_CHECK_PASS : [5]bool = [true, true, false, true, false];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Formal Conformance Vectors";
pub const SAY_NONE : str = "No conformance checks recorded.";
pub const SAY_CHECK : str = "check";
pub const SAY_THRESHOLD : str = "threshold";
pub const SAY_PASS : str = "pass";
pub const SAY_DIRECTORY : str = "conformance/FORMAT-SPEC-001.json holds the conformance vectors.";

; --- Counts ----------------------------------------------------------------------
pub fn check_count() -> u32 {
    return K_CHECK_COUNT as u32;
}

pub fn check_name(i: u32) -> string {
    if (i < K_CHECK_COUNT as u32) { return K_CHECK_NAMES[i as usize]; }
    return "";
}

pub fn check_threshold(i: u32) -> u32 {
    if (i < K_CHECK_COUNT as u32) { return K_CHECK_THRESHOLD[i as usize]; }
    return 0;
}

pub fn check_pass(i: u32) -> bool {
    if (i < K_CHECK_COUNT as u32) { return K_CHECK_PASS[i as usize]; }
    return false;
}

; --- Derived ---------------------------------------------------------------------
pub fn passing_count() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_CHECK_COUNT as u32) {
        if (check_pass(i)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn failing_count() -> u32 {
    return K_CHECK_COUNT as u32 - passing_count();
}

test formal_conformance_has_five_checks {
    assert check_count() == 5;
    assert check_name(0) == "gf16";
    assert check_name(1) == "tnf17";
    assert check_name(4) == "mxfp4";
}

test formal_conformance_thresholds {
    assert check_threshold(0) == 1000;
    assert check_threshold(1) == 500;
    assert check_threshold(4) == 5000;
}

test out_of_range_returns_empty {
    assert check_name(5) == "";
    assert check_threshold(5) == 0;
    assert check_pass(5) == false;
}

test passing_count_is_three {
    assert passing_count() == 3;
}

test failing_count_is_two {
    assert failing_count() == 2;
}

test header_is_fixed {
    assert SAY_HEADER == "Formal conformance Vectors";
    assert SAY_DIRECTORY == "conformance/FORMAT-SPEC-001.json holds the conformance vectors.";
}

invariant thresholds_are_nonzero {
    var i : u32 = 0;
    while (i < K_CHECK_COUNT as u32) {
        assert check_threshold(i) > 0;
        i = i + 1;
    }
}

endmodule
