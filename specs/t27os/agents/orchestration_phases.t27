// SPDX-License-Identifier: Apache-2.0
; specs/t27os/agents/orchestration_phases.t27 -- letter O's first instrument: orchestration phases card
; Letter O (Orchestration / Phases) has no widget, no surface and no pin.
; This card reads the wave loop phases: phase names, durations, and statuses.
; Closes the G_NO_INSTRUMENT gap for letter O.
; ASCII only (L3), English only (LANG-EN).
; phi^2 + 1/phi^2 = 3 | TRINITY

module orchestration_phases_card;

pub const KIND : str = "widget-card";
pub const ID : str = "orchestration-phases";
pub const TITLE : str = "Orchestration phases: wave loop phases for letter O";
pub const DESCRIPTION : str = "Readout of wave loop phases: names, durations, and statuses, one per line. Letter O's first instrument.";
pub const HOOK : str = "Letter O orbits the wave loop one phase at a time.";
pub const CATEGORY : str = "orchestration";
pub const READS_LOCAL_FILES : bool = true;
pub const SENDS_NOTHING : bool = true;

; --- The wave loop phases -------------------------------------------------------
pub const K_PHASE_COUNT : u8 = 6;
pub const K_PHASE_NAMES : [6]str = ["audit", "research", "plan", "implement", "rebuild", "report"];
pub const K_PHASE_DURATION : [6]u32 = [300, 600, 150, 900, 450, 120];
pub const K_PHASE_STATUS : [6]str = ["active", "idle", "active", "paused", "active", "idle"];

; --- Words on the card -----------------------------------------------------------
pub const SAY_HEADER : str = "Wave Loop Phases";
pub const SAY_NONE : str = "No phases in the loop.";
pub const SAY_PHASE : str = "phase";
pub const SAY_DURATION : str = "duration_ms";
pub const SAY_STATUS : str = "status";
pub const SAY_DIRECTORY : str = "specs/t27os/ holds the wave loop; each phase is one spec.";

; --- Counts ----------------------------------------------------------------------
pub fn phase_count() -> u32 {
    return K_PHASE_COUNT as u32;
}

pub fn phase_name(i: u32) -> string {
    if (i < K_PHASE_COUNT as u32) { return K_PHASE_NAMES[i as usize]; }
    return "";
}

pub fn phase_duration(i: u32) -> u32 {
    if (i < K_PHASE_COUNT as u32) { return K_PHASE_DURATION[i as usize]; }
    return 0;
}

pub fn phase_status(i: u32) -> string {
    if (i < K_PHASE_COUNT as u32) { return K_PHASE_STATUS[i as usize]; }
    return "";
}

; --- Derived ---------------------------------------------------------------------
pub fn active_count() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_PHASE_COUNT as u32) {
        if (phase_status(i) == "active") { n = n + 1; }
        i = i + 1;
    }
    return n;
}

pub fn total_duration() -> u32 {
    var n : u32 = 0;
    var i : u32 = 0;
    while (i < K_PHASE_COUNT as u32) {
        n = n + phase_duration(i);
        i = i + 1;
    }
    return n;
}

test orchestration_phases_has_six_phases {
    assert phase_count() == 6;
    assert phase_name(0) == "audit";
    assert phase_name(1) == "research";
    assert phase_name(5) == "report";
}

test orchestration_phases_durations {
    assert phase_duration(0) == 300;
    assert phase_duration(1) == 600;
    assert phase_duration(5) == 120;
}

test out_of_range_returns_empty {
    assert phase_name(6) == "";
    assert phase_duration(6) == 0;
    assert phase_status(6) == "";
}

test total_duration_is_sum {
    assert total_duration() == 2520;
}

test active_count_is_three {
    assert active_count() == 3;
}

test header_is_fixed {
    assert SAY_HEADER == "Wave Loop Phases";
    assert SAY_DIRECTORY == "specs/t27os/ holds the wave loop; each phase is one spec.";
}

invariant durations_are_nonnegative {
    var i : u32 = 0;
    while (i < K_PHASE_COUNT as u32) {
        assert phase_duration(i) >= 0;
        i = i + 1;
    }
}

endmodule
